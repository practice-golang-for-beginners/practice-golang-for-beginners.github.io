## 4️⃣ Nil vs Empty Slice

```go
func TestNilVsEmptySlice(t *testing.T) {
	var a []int
	b := []int{}

	if a != nil {
		t.Error("Expected a to be nil")
	}

	if b == nil {
		t.Error("Expected b to NOT be nil")
	}

	if len(a) != 0 || len(b) != 0 {
		t.Error("Expected both lengths to be 0")
	}
}
```

