## 1️⃣ Array Copy Behavior

```go
func modifyArray(arr [3]int) {
	arr[0] = 100
}

func TestModifyArray_DoesNotChangeOriginal(t *testing.T) {
	a := [3]int{1, 2, 3}
	modifyArray(a)

	if a[0] != 1 {
		t.Errorf("Expected original array unchanged, got %v", a)
	}
}
